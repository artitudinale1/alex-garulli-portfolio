# Server-side Contentful Management API credentials.
# Copy this file to .env and fill in the values. Never commit .env.
CONTENTFUL_MANAGEMENT_TOKEN=
CONTENTFUL_DELIVERY_TOKEN=
CONTENTFUL_SPACE_ID=
CONTENTFUL_ENVIRONMENT=master

# Blog editor. Server-side only. Never prefix these with NEXT_PUBLIC_.
# Generate AUTH_SECRET with: openssl rand -base64 32
# Use a different value of at least 32 characters. EDITOR_AUTH_SECRET must match
# the Render service and must also be at least 32 characters.
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
EDITOR_AUTH_SECRET=

# Image uploads for the private editor. Server-side only.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
