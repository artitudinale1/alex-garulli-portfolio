{
  "name": "alex-portfolio-next",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "migrate": "node scripts/migrate-contentful.mts",
    "migrate:dry-run": "node scripts/migrate-contentful.mts --dry-run",
