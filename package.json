    "next": "16.4.6",
    "next-auth": "5.0.0-beta.32",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "contentful-management": "^12.21.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "typescript": "^5"
  }
